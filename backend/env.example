# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/nyayay-setu

# CORS - the origin your Vite dev server runs on
FRONTEND_ORIGIN=http://localhost:5173

# AI provider
# "mock" uses the built-in scripted mock conversation flow (no API key needed).
# Set this to your real provider key (e.g. "openai") once you wire up ai.service.js.
AI_PROVIDER=mock

# Only needed once you replace the mock with a real AI call.
# NEVER commit a real key here or anywhere in the repo.
OPENAI_API_KEY=
